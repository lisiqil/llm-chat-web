# 复制为项目根目录的 .env 后填写。不要把真实密钥提交到版本库。

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# llama-server 的 OpenAI 兼容地址，必须包含 /v1。只配置在后端。
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=local-model

# 开始做持久化时再填写。
DATABASE_URL=postgresql+psycopg://appuser:password@127.0.0.1:5432/llmAppDb
